<!DOCTYPE html>
<html lang="es" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EnglishVibe - Aprende Inglés B1-B2</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f3ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#1e1b4b'
                        }
                    }
                }
            }
        }
    </script>
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Web App Manifest Dynamic Injection -->
    <link rel="manifest" id="manifest-placeholder">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .perspective-1000 { perspective: 1000px; }
        .transform-style-3d { transform-style: preserve-3d; }
        .backface-hidden { backface-visibility: hidden; }
        .rotate-y-180 { transform: rotateY(180deg); }
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(255, 255, 255, 0.25); }
    </style>
</head>
<body class="h-full flex flex-col bg-slate-950 text-slate-100 selection:bg-indigo-500 selection:text-white" 
      x-data="englishApp()" 
      x-init="initApp()">

    <!-- HEADER / NAVIGATION BAR -->
    <header class="sticky top-0 z-40 bg-slate-900/80 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <!-- Logo -->
            <div class="flex items-center gap-3 cursor-pointer" @click="activeTab = 'dashboard'">
                <div class="w-10 h-10 rounded-2xl bg-indigo-600/30 text-indigo-400 flex items-center justify-center font-bold text-lg shadow-sm">
                    B2
                </div>
                <span class="font-bold text-lg tracking-tight text-white">
                    EnglishVibe
                </span>
            </div>

            <!-- Stats & Download App Action -->
            <div class="flex items-center gap-3">
                <!-- Stats Indicator -->
                <div class="hidden sm:flex items-center gap-3 bg-slate-900/90 rounded-full px-4 py-1.5 text-xs text-slate-300 shadow-sm">
                    <div class="flex items-center gap-1.5 text-amber-400 font-semibold" title="Racha de días">
                        <i data-lucide="flame" class="w-4 h-4"></i>
                        <span x-text="stats.streak"></span>
                        <span class="text-slate-400">días</span>
                    </div>
                    <div class="h-3 w-px bg-slate-800"></div>
                    <div class="flex items-center gap-1.5 text-indigo-400 font-semibold" title="Puntos XP">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span x-text="stats.xp"></span>
                        <span class="text-slate-400">XP</span>
                    </div>
                </div>

                <!-- Download Mobile App Button -->
                <button @click="showDownloadModal = true" 
                        class="px-3.5 py-2 rounded-xl bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 font-medium text-xs transition flex items-center gap-2 shadow-sm">
                    <i data-lucide="smartphone" class="w-4 h-4"></i>
                    <span class="hidden sm:inline">Instalar App</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 pb-24 md:pb-8">

        <!-- 1. DASHBOARD -->
        <section x-show="activeTab === 'dashboard'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
            <!-- Hero Banner -->
            <div class="rounded-3xl bg-slate-900/80 p-6 md:p-10 mb-8 shadow-sm">
                <div class="max-w-2xl">
                    <span class="px-3 py-1 text-xs font-medium bg-indigo-500/10 text-indigo-300 rounded-full">Nivel B1 - B2 Intermedio Alto</span>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-white mt-4 mb-3 tracking-tight">Inglés real, cotidiano y fluido</h1>
                    <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-6">Aprende expresiones idiomáticas, jerga del día a día, gramática intermedia y practica con ejercicios sin complicaciones.</p>
                    <div class="flex flex-wrap gap-3">
                        <button @click="activeTab = 'vocab'" class="px-5 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold shadow-sm transition flex items-center gap-2">
                            <i data-lucide="book-open" class="w-4 h-4"></i> Estudiar Vocabulario
                        </button>
                        <button @click="activeTab = 'games'" class="px-5 py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-semibold transition flex items-center gap-2">
                            <i data-lucide="gamepad-2" class="w-4 h-4"></i> Ir a Juegos
                        </button>
                    </div>
                </div>
            </div>

            <!-- Dashboard Grid -->
            <h2 class="text-lg font-bold text-white mb-4 flex items-center gap-2">
                <i data-lucide="compass" class="w-4 h-4 text-indigo-400"></i> Secciones de Aprendizaje
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
                <!-- Card 1: Vocab -->
                <div @click="activeTab = 'vocab'; vocabMode = 'flashcards'" class="bg-slate-900/60 hover:bg-slate-900 p-6 rounded-2xl transition cursor-pointer shadow-sm group">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-4">
                        <i data-lucide="layers" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-1">Módulo de Vocabulario</h3>
                    <p class="text-slate-400 text-xs leading-relaxed mb-4">Palabras clave cotidianas, pronunciación en audio y tarjetas dinámicas.</p>
                    <span class="text-xs font-medium text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition">Ver palabras <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i></span>
                </div>

                <!-- Card 2: Grammar -->
                <div @click="activeTab = 'grammar'" class="bg-slate-900/60 hover:bg-slate-900 p-6 rounded-2xl transition cursor-pointer shadow-sm group">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-4">
                        <i data-lucide="file-text" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-1">Gramática B1-B2</h3>
                    <p class="text-slate-400 text-xs leading-relaxed mb-4">Condicionales, voz pasiva, hábitos pasados y modales de deducción.</p>
                    <span class="text-xs font-medium text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition">Ver lecciones <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i></span>
                </div>

                <!-- Card 3: Games -->
                <div @click="activeTab = 'games'" class="bg-slate-900/60 hover:bg-slate-900 p-6 rounded-2xl transition cursor-pointer shadow-sm group">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 text-indigo-400 flex items-center justify-center mb-4">
                        <i data-lucide="gamepad-2" class="w-5 h-5"></i>
                    </div>
                    <h3 class="text-base font-bold text-white mb-1">Zona de Juegos</h3>
                    <p class="text-slate-400 text-xs leading-relaxed mb-4">Juegos de parejas (Matching) y ordenar letras (Word Scramble).</p>
                    <span class="text-xs font-medium text-indigo-400 flex items-center gap-1 group-hover:translate-x-1 transition">Jugar <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i></span>
                </div>
            </div>

            <!-- Progress Summary -->
            <div class="bg-slate-900/40 p-6 rounded-2xl shadow-sm">
                <h3 class="text-sm font-bold text-white mb-4 flex items-center gap-2">
                    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i> Progreso de Aprendizaje
                </h3>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
                    <div class="bg-slate-900/80 p-4 rounded-xl shadow-sm">
                        <span class="text-xs text-slate-400 block mb-1">Palabras Sabidas</span>
                        <span class="text-2xl font-bold text-white" x-text="stats.masteredWords.length"></span>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-xl shadow-sm">
                        <span class="text-xs text-slate-400 block mb-1">Puntos XP</span>
                        <span class="text-2xl font-bold text-indigo-400" x-text="stats.xp"></span>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-xl shadow-sm">
                        <span class="text-xs text-slate-400 block mb-1">Racha Actual</span>
                        <span class="text-2xl font-bold text-amber-400" x-text="stats.streak + ' días'"></span>
                    </div>
                    <div class="bg-slate-900/80 p-4 rounded-xl shadow-sm">
                        <span class="text-xs text-slate-400 block mb-1">Favoritas</span>
                        <span class="text-2xl font-bold text-indigo-300" x-text="stats.favorites.length"></span>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. VOCABULARY TAB -->
        <section x-show="activeTab === 'vocab'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
            <!-- Controls Bar -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <!-- Mode Tabs -->
                <div class="flex bg-slate-900/80 p-1 rounded-xl w-fit">
                    <button @click="vocabMode = 'flashcards'" 
                            :class="vocabMode === 'flashcards' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'"
                            class="px-4 py-2 rounded-lg font-medium text-xs transition flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4"></i> Tarjetas
                    </button>
                    <button @click="vocabMode = 'quiz'" 
                            :class="vocabMode === 'quiz' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'"
                            class="px-4 py-2 rounded-lg font-medium text-xs transition flex items-center gap-2">
                        <i data-lucide="help-circle" class="w-4 h-4"></i> Test / Quiz
                    </button>
                    <button @click="vocabMode = 'list'" 
                            :class="vocabMode === 'list' ? 'bg-indigo-600 text-white' : 'text-slate-400 hover:text-white'"
                            class="px-4 py-2 rounded-lg font-medium text-xs transition flex items-center gap-2">
                        <i data-lucide="list" class="w-4 h-4"></i> Lista Completa
                    </button>
                </div>

                <!-- Category Pills -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 max-w-full">
                    <button @click="selectedCategory = 'all'" 
                            :class="selectedCategory === 'all' ? 'bg-slate-800 text-indigo-300' : 'bg-slate-900/60 text-slate-400'"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium transition whitespace-nowrap">Todas</button>
                    <button @click="selectedCategory = 'slang'" 
                            :class="selectedCategory === 'slang' ? 'bg-slate-800 text-indigo-300' : 'bg-slate-900/60 text-slate-400'"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium transition whitespace-nowrap">Slang y Diario</button>
                    <button @click="selectedCategory = 'feelings'" 
                            :class="selectedCategory === 'feelings' ? 'bg-slate-800 text-indigo-300' : 'bg-slate-900/60 text-slate-400'"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium transition whitespace-nowrap">Sentimientos</button>
                    <button @click="selectedCategory = 'favorites'" 
                            :class="selectedCategory === 'favorites' ? 'bg-slate-800 text-amber-300' : 'bg-slate-900/60 text-slate-400'"
                            class="px-3 py-1.5 rounded-lg text-xs font-medium transition flex items-center gap-1 whitespace-nowrap">
                        <i data-lucide="star" class="w-3 h-3 text-amber-400"></i> Favoritas
                    </button>
                </div>
            </div>

            <!-- MODE 1: FLASHCARDS -->
            <div x-show="vocabMode === 'flashcards'" class="max-w-xl mx-auto py-2">
                <template x-if="filteredWords.length > 0">
                    <div>
                        <!-- Index Indicator -->
                        <div class="flex justify-between items-center text-xs text-slate-400 mb-3">
                            <span>Tarjeta <strong class="text-white" x-text="currentCardIndex + 1"></strong> de <strong class="text-white" x-text="filteredWords.length"></strong></span>
                            <span class="text-emerald-400 font-medium" x-show="isMastered(currentWord.id)">Aprendida</span>
                        </div>

                        <!-- 3D Card Container -->
                        <div class="perspective-1000 min-h-[300px] w-full cursor-pointer" @click="cardFlipped = !cardFlipped">
                            <div class="relative w-full h-80 rounded-3xl transition-transform duration-500 transform-style-3d bg-slate-900 shadow-md"
                                 :class="cardFlipped ? 'rotate-y-180' : ''">
                                
                                <!-- CARD FRONT -->
                                <div class="absolute inset-0 w-full h-full rounded-3xl p-8 flex flex-col justify-between backface-hidden">
                                    <div class="flex justify-between items-center">
                                        <span class="px-3 py-1 rounded-full text-xs font-medium bg-indigo-500/10 text-indigo-300" x-text="currentWord.category"></span>
                                        <button @click.stop="toggleFavorite(currentWord.id)" class="text-slate-600 hover:text-amber-400 transition p-1">
                                            <i data-lucide="star" class="w-5 h-5" :class="isFavorite(currentWord.id) ? 'text-amber-400 fill-amber-400' : ''"></i>
                                        </button>
                                    </div>

                                    <div class="text-center my-auto">
                                        <h2 class="text-3xl md:text-4xl font-bold text-white mb-2" x-text="currentWord.word"></h2>
                                        <p class="text-indigo-300/80 text-xs italic mb-4" x-text="currentWord.phonetic"></p>
                                        <button @click.stop="speak(currentWord.word)" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 text-xs font-semibold transition">
                                            <i data-lucide="volume-2" class="w-4 h-4"></i> Escuchar Pronunciación
                                        </button>
                                    </div>

                                    <div class="text-center text-xs text-slate-500 flex items-center justify-center gap-1">
                                        <i data-lucide="rotate-cw" class="w-3 h-3"></i> Toca para ver significado
                                    </div>
                                </div>

                                <!-- CARD BACK -->
                                <div class="absolute inset-0 w-full h-full rounded-3xl p-8 flex flex-col justify-between backface-hidden rotate-y-180 bg-slate-900">
                                    <div class="flex justify-between items-center">
                                        <span class="text-xs text-slate-400">Traducción y Contexto</span>
                                        <button @click.stop="speak(currentWord.example)" class="text-slate-400 hover:text-indigo-300 transition">
                                            <i data-lucide="volume-2" class="w-4 h-4"></i>
                                        </button>
                                    </div>

                                    <div class="text-center my-auto">
                                        <h3 class="text-2xl font-bold text-emerald-400 mb-4" x-text="currentWord.translation"></h3>
                                        <div class="bg-slate-950/50 p-4 rounded-2xl text-left">
                                            <p class="text-slate-200 text-xs font-medium italic mb-1" x-text="'&quot;' + currentWord.example + '&quot;'"></p>
                                            <p class="text-slate-400 text-xs" x-text="currentWord.exampleEs"></p>
                                        </div>
                                    </div>

                                    <div class="text-center text-xs text-slate-500">
                                        Toca para voltear
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Card Controls -->
                        <div class="flex items-center justify-between gap-4 mt-6">
                            <button @click="prevCard()" class="p-3 rounded-2xl bg-slate-900 text-slate-200 hover:bg-slate-850 transition shadow-sm">
                                <i data-lucide="chevron-left" class="w-5 h-5"></i>
                            </button>

                            <button @click="toggleMastered(currentWord.id)" 
                                    :class="isMastered(currentWord.id) ? 'bg-emerald-500/20 text-emerald-400' : 'bg-slate-900 text-slate-400 hover:text-slate-200'"
                                    class="px-5 py-2.5 rounded-2xl text-xs font-semibold transition flex items-center gap-2 shadow-sm">
                                <i data-lucide="check" class="w-4 h-4"></i> 
                                <span x-text="isMastered(currentWord.id) ? 'Sabida' : 'Marcar como Sabida'"></span>
                            </button>

                            <button @click="nextCard()" class="p-3 rounded-2xl bg-slate-900 text-slate-200 hover:bg-slate-850 transition shadow-sm">
                                <i data-lucide="chevron-right" class="w-5 h-5"></i>
                            </button>
                        </div>
                    </div>
                </template>
                <template x-if="filteredWords.length === 0">
                    <div class="text-center py-12 bg-slate-900/60 rounded-3xl">
                        <p class="text-slate-400 text-sm">No hay palabras disponibles en este filtro.</p>
                    </div>
                </template>
            </div>

            <!-- MODE 2: QUIZ -->
            <div x-show="vocabMode === 'quiz'" class="max-w-xl mx-auto py-2">
                <template x-if="quizQuestion">
                    <div class="bg-slate-900 p-6 md:p-8 rounded-3xl shadow-sm">
                        <div class="flex justify-between items-center mb-6">
                            <span class="text-xs font-semibold text-indigo-400">Quiz de Vocabulario</span>
                            <span class="text-xs bg-indigo-500/10 text-indigo-300 px-3 py-1 rounded-full font-medium" x-text="'Puntos: ' + quizScore"></span>
                        </div>

                        <div class="text-center mb-8">
                            <p class="text-slate-400 text-xs mb-1">¿Cuál es el significado correcto?</p>
                            <h2 class="text-3xl font-bold text-white mb-2" x-text="quizQuestion.word"></h2>
                            <button @click="speak(quizQuestion.word)" class="text-indigo-400 text-xs font-medium inline-flex items-center gap-1">
                                <i data-lucide="volume-2" class="w-3.5 h-3.5"></i> Escuchar
                            </button>
                        </div>

                        <div class="space-y-3 mb-6">
                            <template x-for="(option, index) in quizOptions" :key="index">
                                <button @click="answerQuiz(option)" 
                                        :disabled="quizAnswered"
                                        :class="getQuizOptionClass(option)"
                                        class="w-full text-left p-4 rounded-2xl font-medium text-sm transition flex items-center justify-between">
                                    <span x-text="option"></span>
                                    <template x-if="quizAnswered && option === quizQuestion.translation">
                                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
                                    </template>
                                </button>
                            </template>
                        </div>

                        <div x-show="quizAnswered" class="flex items-center justify-between pt-4">
                            <div>
                                <p class="font-semibold text-xs" :class="isQuizCorrect ? 'text-emerald-400' : 'text-slate-400'" x-text="isQuizCorrect ? 'Correcto +10 XP' : 'Respuesta correcta: ' + quizQuestion.translation"></p>
                            </div>
                            <button @click="nextQuizQuestion()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-semibold text-xs transition flex items-center gap-2">
                                Siguiente <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                </template>
            </div>

            <!-- MODE 3: LIST / SEARCH -->
            <div x-show="vocabMode === 'list'" class="space-y-4">
                <div class="relative max-w-md mb-6">
                    <i data-lucide="search" class="w-4 h-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-500"></i>
                    <input type="text" x-model="searchQuery" placeholder="Buscar en inglés o español..." 
                           class="w-full bg-slate-900/80 rounded-xl pl-10 pr-4 py-2.5 text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-indigo-500 text-xs">
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <template x-for="item in searchedWords" :key="item.id">
                        <div class="bg-slate-900/80 rounded-2xl p-5 shadow-sm flex flex-col justify-between">
                            <div>
                                <div class="flex items-start justify-between gap-2 mb-2">
                                    <h3 class="text-lg font-bold text-white flex items-center gap-2">
                                        <span x-text="item.word"></span>
                                        <button @click="speak(item.word)" class="text-indigo-400 p-1">
                                            <i data-lucide="volume-2" class="w-4 h-4"></i>
                                        </button>
                                    </h3>
                                    <button @click="toggleFavorite(item.id)" class="text-slate-600 hover:text-amber-400">
                                        <i data-lucide="star" class="w-4 h-4" :class="isFavorite(item.id) ? 'text-amber-400 fill-amber-400' : ''"></i>
                                    </button>
                                </div>
                                <p class="text-emerald-400 font-semibold text-xs mb-3" x-text="item.translation"></p>
                                <p class="text-slate-400 text-xs italic bg-slate-950/40 p-3 rounded-xl" x-text="'&quot;' + item.example + '&quot;'"></p>
                            </div>
                            <div class="mt-4 pt-3 flex items-center justify-between text-xs">
                                <span class="text-slate-500 capitalize" x-text="item.category"></span>
                                <button @click="toggleMastered(item.id)" 
                                        :class="isMastered(item.id) ? 'text-emerald-400 font-semibold' : 'text-slate-500 hover:text-slate-300'"
                                        class="flex items-center gap-1 transition">
                                    <i data-lucide="check-circle" class="w-3.5 h-3.5"></i>
                                    <span x-text="isMastered(item.id) ? 'Sabida' : 'Marcar sabida'"></span>
                                </button>
                            </div>
                        </div>
                    </template>
                </div>
            </div>
        </section>

        <!-- 3. GRAMMAR TAB -->
        <section x-show="activeTab === 'grammar'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
            <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                <!-- Topics Menu -->
                <div class="md:col-span-4 lg:col-span-3 space-y-2">
                    <h3 class="text-xs font-semibold text-slate-400 mb-3 px-1 uppercase tracking-wider">Temas B1-B2</h3>
                    <template x-for="(topic, idx) in grammarTopics" :key="topic.id">
                        <button @click="activeGrammarIndex = idx" 
                                :class="activeGrammarIndex === idx ? 'bg-indigo-600/20 text-indigo-300' : 'bg-slate-900/60 text-slate-400 hover:text-slate-200'"
                                class="w-full text-left p-3.5 rounded-xl text-xs font-semibold transition flex items-center justify-between shadow-sm">
                            <span x-text="topic.title"></span>
                            <i data-lucide="chevron-right" class="w-4 h-4 opacity-60"></i>
                        </button>
                    </template>
                </div>

                <!-- Topic Explanation Content -->
                <div class="md:col-span-8 lg:col-span-9">
                    <div class="bg-slate-900 rounded-3xl p-6 md:p-8 space-y-6 shadow-sm">
                        <div>
                            <span class="text-xs font-medium text-indigo-300 bg-indigo-500/10 px-3 py-1 rounded-full">Gramática</span>
                            <h2 class="text-2xl font-bold text-white mt-3" x-text="currentGrammarTopic.title"></h2>
                            <p class="text-slate-400 text-xs mt-1" x-text="currentGrammarTopic.subtitle"></p>
                        </div>

                        <div class="bg-slate-950/50 rounded-2xl p-5 space-y-2">
                            <h4 class="font-semibold text-slate-200 text-xs flex items-center gap-2">
                                <i data-lucide="info" class="w-4 h-4 text-indigo-400"></i> Explicación:
                            </h4>
                            <p class="text-slate-300 text-xs leading-relaxed" x-text="currentGrammarTopic.explanation"></p>
                            
                            <template x-if="currentGrammarTopic.formula">
                                <div class="mt-3 inline-block bg-indigo-950/60 text-indigo-300 px-3 py-1.5 rounded-lg text-xs font-mono">
                                    <span class="text-slate-400">Estructura:</span> <span x-text="currentGrammarTopic.formula"></span>
                                </div>
                            </template>
                        </div>

                        <div>
                            <h4 class="font-semibold text-slate-200 text-xs mb-3">Ejemplos de Uso:</h4>
                            <div class="space-y-2">
                                <template x-for="ex in currentGrammarTopic.examples" :key="ex.en">
                                    <div class="p-3.5 rounded-xl bg-slate-950/40 flex flex-col sm:flex-row justify-between sm:items-center gap-1">
                                        <span class="font-medium text-indigo-300 text-xs" x-text="ex.en"></span>
                                        <span class="text-slate-400 text-xs italic" x-text="ex.es"></span>
                                    </div>
                                </template>
                            </div>
                        </div>

                        <!-- Mini Exercise -->
                        <div class="pt-6 border-t border-slate-800/60">
                            <h4 class="font-bold text-white text-sm mb-3 flex items-center gap-2">
                                <i data-lucide="pen-tool" class="w-4 h-4 text-emerald-400"></i> Ejercicio de Práctica
                            </h4>

                            <div class="bg-slate-950/60 p-5 rounded-2xl">
                                <p class="text-slate-200 font-medium text-xs mb-4" x-text="currentGrammarTopic.exercise.question"></p>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                                    <template x-for="opt in currentGrammarTopic.exercise.options" :key="opt">
                                        <button @click="checkGrammarAnswer(opt)" 
                                                :disabled="grammarAnswered"
                                                :class="getGrammarOptClass(opt)"
                                                class="p-3 rounded-xl text-xs font-medium transition text-left">
                                            <span x-text="opt"></span>
                                        </button>
                                    </template>
                                </div>

                                <div x-show="grammarAnswered" class="p-3 rounded-xl text-xs font-semibold" 
                                     :class="grammarIsCorrect ? 'bg-emerald-500/10 text-emerald-400' : 'bg-slate-800 text-slate-300'">
                                    <span x-text="grammarIsCorrect ? '¡Correcto! +15 XP' : 'Respuesta incorrecta. Vuelve a intentarlo.'"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. GAMES TAB -->
        <section x-show="activeTab === 'games'" x-transition:enter="transition ease-out duration-200" x-transition:enter-start="opacity-0 translate-y-2" x-transition:enter-end="opacity-100 translate-y-0">
            <!-- Game selector -->
            <div class="flex justify-center gap-3 mb-8">
                <button @click="gameMode = 'scramble'" 
                        :class="gameMode === 'scramble' ? 'bg-indigo-600 text-white' : 'bg-slate-900/80 text-slate-400'"
                        class="px-5 py-2.5 rounded-2xl font-semibold text-xs transition flex items-center gap-2 shadow-sm">
                    <i data-lucide="shuffle" class="w-4 h-4"></i> Word Scramble
                </button>
                <button @click="gameMode = 'matching'" 
                        :class="gameMode === 'matching' ? 'bg-indigo-600 text-white' : 'bg-slate-900/80 text-slate-400'"
                        class="px-5 py-2.5 rounded-2xl font-semibold text-xs transition flex items-center gap-2 shadow-sm">
                    <i data-lucide="grid" class="w-4 h-4"></i> Juego de Parejas
                </button>
            </div>

            <!-- GAME 1: WORD SCRAMBLE -->
            <div x-show="gameMode === 'scramble'" class="max-w-md mx-auto">
                <div class="bg-slate-900 rounded-3xl p-6 md:p-8 text-center shadow-sm">
                    <span class="px-3 py-1 rounded-full text-xs font-medium bg-indigo-500/10 text-indigo-300">Ortografía</span>
                    <h2 class="text-xl font-bold text-white mt-4 mb-2">Ordena la Palabra</h2>
                    <p class="text-slate-400 text-xs mb-6">Traducción: <strong class="text-emerald-400" x-text="scrambleWord.translation"></strong></p>

                    <div class="flex justify-center gap-2 mb-6 flex-wrap">
                        <template x-for="(char, i) in scrambledLetters" :key="i">
                            <span class="w-10 h-10 bg-slate-950 rounded-xl flex items-center justify-center font-bold text-lg text-indigo-300" x-text="char.toUpperCase()"></span>
                        </template>
                    </div>

                    <form @submit.prevent="checkScrambleAnswer()" class="space-y-4">
                        <input type="text" x-model="scrambleInput" placeholder="Escribe la palabra..." 
                               class="w-full bg-slate-950 rounded-xl px-4 py-3 text-center text-base font-bold text-white placeholder-slate-600 focus:outline-none uppercase tracking-widest">
                        
                        <div class="flex gap-2">
                            <button type="submit" class="flex-1 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-xs rounded-xl shadow-sm transition">
                                Comprobar
                            </button>
                            <button type="button" @click="initScrambleGame()" class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition">
                                <i data-lucide="refresh-cw" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </form>

                    <div x-show="scrambleFeedback" class="mt-4 p-3 rounded-xl text-xs font-semibold" 
                         :class="scrambleSuccess ? 'bg-emerald-500/10 text-emerald-400' : 'bg-slate-800 text-slate-300'"
                         x-text="scrambleFeedback"></div>
                </div>
            </div>

            <!-- GAME 2: MATCHING GAME -->
            <div x-show="gameMode === 'matching'" class="max-w-2xl mx-auto">
                <div class="bg-slate-900 rounded-3xl p-6 md:p-8 shadow-sm">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h2 class="text-xl font-bold text-white">Emparejar Términos</h2>
                            <p class="text-slate-400 text-xs">Junta cada término en inglés con su significado en español.</p>
                        </div>
                        <button @click="initMatchingGame()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-medium rounded-lg transition flex items-center gap-1">
                            <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Reiniciar
                        </button>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <template x-for="card in matchCards" :key="card.id">
                            <button @click="selectMatchCard(card)" 
                                    :disabled="card.matched"
                                    :class="getMatchCardClass(card)"
                                    class="h-20 p-3 rounded-2xl font-semibold text-xs flex items-center justify-center text-center transition shadow-sm">
                                <span x-text="card.text"></span>
                            </button>
                        </template>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- MOBILE MODAL: APP INSTALL / DOWNLOAD -->
    <div x-show="showDownloadModal" 
         x-transition:enter="transition ease-out duration-200" 
         x-transition:enter-start="opacity-0" 
         x-transition:enter-end="opacity-100"
         x-transition:leave="transition ease-in duration-150" 
         x-transition:leave-start="opacity-100" 
         x-transition:leave-end="opacity-0"
         class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4" 
         style="display: none;">
        
        <div @click.away="showDownloadModal = false" class="bg-slate-900 rounded-3xl p-6 max-w-md w-full shadow-2xl space-y-6">
            <div class="flex justify-between items-start">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-2xl bg-indigo-600/20 text-indigo-400 flex items-center justify-center">
                        <i data-lucide="smartphone" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-white">Instalar App Móvil</h3>
                        <p class="text-slate-400 text-xs">Acceso directo sin descargas pesadas</p>
                    </div>
                </div>
                <button @click="showDownloadModal = false" class="text-slate-500 hover:text-slate-300">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Install Option 1: PWA Add to Home Screen Instructions -->
            <div class="space-y-3 bg-slate-950/50 p-4 rounded-2xl text-xs">
                <h4 class="font-semibold text-indigo-300">Añadir a la pantalla de inicio:</h4>
                <div class="space-y-2 text-slate-300">
                    <div class="flex items-start gap-2">
                        <span class="font-bold text-indigo-400">iOS (Safari):</span>
                        <span>Pulsa el botón <strong>Compartir</strong> (icono de cuadrado con flecha) y selecciona <strong>"Añadir a la pantalla de inicio"</strong>.</span>
                    </div>
                    <div class="flex items-start gap-2">
                        <span class="font-bold text-indigo-400">Android (Chrome):</span>
                        <span>Pulsa los <strong>3 puntos horizontales</strong> arriba a la derecha y selecciona <strong>"Instalar aplicación"</strong> o <strong>"Añadir a pantalla de inicio"</strong>.</span>
                    </div>
                </div>
            </div>

            <!-- Install Option 2: Download Fast Shortcut File -->
            <div class="space-y-2">
                <button @click="downloadShortcutFile()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-semibold text-xs transition flex items-center justify-center gap-2 shadow-sm">
                    <i data-lucide="download" class="w-4 h-4"></i> Descargar Acceso Rápido WebApp (.html)
                </button>
                <p class="text-[11px] text-slate-500 text-center">Puedes guardar el archivo para abrir la app sin conexión a internet.</p>
            </div>
        </div>
    </div>

    <!-- MOBILE NAVIGATION -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-slate-900/95 backdrop-blur-md z-40">
        <div class="grid grid-cols-4 h-16">
            <button @click="activeTab = 'dashboard'" :class="activeTab === 'dashboard' ? 'text-indigo-400' : 'text-slate-500'" class="flex flex-col items-center justify-center gap-1">
                <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                <span class="text-[10px] font-medium">Inicio</span>
            </button>
            <button @click="activeTab = 'vocab'" :class="activeTab === 'vocab' ? 'text-indigo-400' : 'text-slate-500'" class="flex flex-col items-center justify-center gap-1">
                <i data-lucide="book-open" class="w-5 h-5"></i>
                <span class="text-[10px] font-medium">Vocabulario</span>
            </button>
            <button @click="activeTab = 'grammar'" :class="activeTab === 'grammar' ? 'text-indigo-400' : 'text-slate-500'" class="flex flex-col items-center justify-center gap-1">
                <i data-lucide="file-text" class="w-5 h-5"></i>
                <span class="text-[10px] font-medium">Gramática</span>
            </button>
            <button @click="activeTab = 'games'" :class="activeTab === 'games' ? 'text-indigo-400' : 'text-slate-500'" class="flex flex-col items-center justify-center gap-1">
                <i data-lucide="gamepad-2" class="w-5 h-5"></i>
                <span class="text-[10px] font-medium">Juegos</span>
            </button>
        </div>
    </nav>

    <!-- JS LOGIC -->
    <script>
        function englishApp() {
            return {
                activeTab: 'dashboard',
                vocabMode: 'flashcards',
                selectedCategory: 'all',
                searchQuery: '',
                showDownloadModal: false,
                
                stats: {
                    xp: 0,
                    streak: 1,
                    masteredWords: [],
                    favorites: []
                },

                // Mandatory vocabulary + B1-B2 terms
                words: [
                    { id: 1, word: 'Loo', translation: 'Baño / W.C.', phonetic: '/luː/', category: 'slang', example: 'I need to go to the loo before we leave.', exampleEs: 'Necesito ir al baño antes de salir.' },
                    { id: 2, word: 'Nosebleed', translation: 'Sangrado de nariz', phonetic: '/ˈnəʊz.bliːd/', category: 'daily', example: 'The dry air gave him a nosebleed.', exampleEs: 'El aire seco le provocó un sangrado de nariz.' },
                    { id: 3, word: 'Hungover', translation: 'Resaca', phonetic: '/ˌhʌŋˈəʊ.vər/', category: 'slang', example: 'I woke up feeling completely hungover.', exampleEs: 'Me desperté sintiéndome con mucha resaca.' },
                    { id: 4, word: 'Steal', translation: 'Robar / Chollo / Ganga', phonetic: '/stiːl/', category: 'daily', example: 'At this low price, this coat is an absolute steal.', exampleEs: 'A este precio tan bajo, este abrigo es un auténtico chollo.' },
                    { id: 5, word: 'Regret', translation: 'Arrepentirse', phonetic: '/rɪˈɡret/', category: 'feelings', example: 'She doesn\'t regret taking that job opportunity.', exampleEs: 'Ella no se arrepiente de tomar esa oportunidad laboral.' },
                    { id: 6, word: 'Slightly', translation: 'Levemente', phonetic: '/ˈslaɪt.li/', category: 'daily', example: 'The room was slightly warmer than outside.', exampleEs: 'La habitación estaba levemente más caliente que afuera.' },
                    { id: 7, word: 'Weed', translation: 'Hierba', phonetic: '/wiːd/', category: 'slang', example: 'We need to pull out the weeds in the garden.', exampleEs: 'Necesitamos quitar las malas hierbas del jardín.' },
                    { id: 8, word: 'Not that I recall', translation: 'No que yo recuerde', phonetic: '/nɒt ðæt aɪ rɪˈkɔːl/', category: 'slang', example: 'Has he called today? Not that I recall.', exampleEs: '¿Ha llamado hoy? No que yo recuerde.' },
                    { id: 9, word: 'Handjob', translation: 'Paja / Masturbación manual', phonetic: '/ˈhænd.dʒɒb/', category: 'slang', example: 'Informal adult terminology.', exampleEs: 'Terminología adulta informal.' },
                    { id: 10, word: 'What a waste', translation: 'Qué desperdicio', phonetic: '/wɒt ə weɪst/', category: 'slang', example: 'Throwing away food is what a waste.', exampleEs: 'Tirar comida es qué desperdicio.' },
                    { id: 11, word: 'Walking me home', translation: 'Acompañarme a casa', phonetic: '/ˈwɔː.kɪŋ miː həʊm/', category: 'daily', example: 'Thanks for walking me home tonight.', exampleEs: 'Gracias por acompañarme a casa esta noche.' },
                    { id: 12, word: 'Glad', translation: 'Contenta / Alegre', phonetic: '/ɡlæd/', category: 'feelings', example: 'I am so glad to meet you.', exampleEs: 'Estoy tan contenta de conocerte.' },
                    { id: 13, word: 'Snore', translation: 'Roncar', phonetic: '/snɔːr/', category: 'daily', example: 'He snores loudly when he sleeps.', exampleEs: 'Él ronca fuerte cuando duerme.' },
                    { id: 14, word: 'Hit the sack', translation: 'Irse a dormir', phonetic: '/hɪt ðə sæk/', category: 'slang', example: 'I am exhausted, time to hit the sack.', exampleEs: 'Estoy exhausto, hora de irse a dormir.' },
                    { id: 15, word: 'Bite the bullet', translation: 'Hacer de tripas corazón', phonetic: '/baɪt ðə ˈbʊl.ɪt/', category: 'slang', example: 'I had to bite the bullet and apologize.', exampleEs: 'Tuve que hacer de tripas corazón y pedir disculpas.' },
                    { id: 16, word: 'Ghost', translation: 'Hacer ghosting / Ignorar', phonetic: '/ɡəʊst/', category: 'slang', example: 'She stopped replying and ghosted him.', exampleEs: 'Dejó de responder y le hizo ghosting.' }
                ],

                // Flashcard State
                currentCardIndex: 0,
                cardFlipped: false,

                // Quiz State
                quizQuestion: null,
                quizOptions: [],
                quizAnswered: false,
                isQuizCorrect: false,
                quizScore: 0,

                // Grammar Data
                activeGrammarIndex: 0,
                grammarAnswered: false,
                grammarIsCorrect: false,
                grammarTopics: [
                    {
                        id: 'conditionals',
                        title: 'Second & Third Conditionals',
                        subtitle: 'Hipótesis en presente y pasado',
                        explanation: 'El 2º condicional describe hipótesis en el presente (If + Past Simple, Would + Verb). El 3º condicional habla de arrepentimientos del pasado (If + Past Perfect, Would have + Participle).',
                        formula: '3rd: If + Past Perfect -> Would have + Participle',
                        examples: [
                            { en: 'If I won the lottery, I would buy a house.', es: 'Si ganara la lotería, compraría una casa.' },
                            { en: 'If I had studied, I would have passed.', es: 'Si hubiera estudiado, habría aprobado.' }
                        ],
                        exercise: {
                            question: 'Completa: "If she _____ (know) about it, she would have come."',
                            options: ['knew', 'had known', 'has known', 'would know'],
                            correct: 'had known'
                        }
                    },
                    {
                        id: 'passive',
                        title: 'Voz Pasiva (Passive Voice)',
                        subtitle: 'Enfocar la acción en lugar de la persona',
                        explanation: 'La voz pasiva se utiliza para destacar la acción o el objeto afectado. Se compone con la forma correspondiente de To Be + Participio Pasado.',
                        formula: 'Object + Verb To Be + Past Participle',
                        examples: [
                            { en: 'The keys were stolen yesterday.', es: 'Las llaves fueron robadas ayer.' },
                            { en: 'English is spoken all over the world.', es: 'El inglés es hablado en todo el mundo.' }
                        ],
                        exercise: {
                            question: 'Elige la opción pasiva correcta para "They built this house in 1995":',
                            options: ['This house was built in 1995.', 'This house built in 1995.', 'This house is built.', 'This house has built.'],
                            correct: 'This house was built in 1995.'
                        }
                    },
                    {
                        id: 'usedto',
                        title: 'Used to vs Get used to',
                        subtitle: 'Hábitos pasados vs Acostumbrarse',
                        explanation: '"Used to + verbo" se usa para hábitos que ya no ocurren. "Get used to + verb-ing" expresa el proceso de acostumbrarse a algo nuevo.',
                        formula: 'Get used to + Verb-ING',
                        examples: [
                            { en: 'I used to snore when I was young.', es: 'Solía roncar cuando era joven.' },
                            { en: 'I am getting used to driving on the left.', es: 'Me estoy acostumbrando a conducir por la izquierda.' }
                        ],
                        exercise: {
                            question: 'Completa: "It took me months to _____ waking up early."',
                            options: ['get used to', 'used to', 'use to', 'getting used'],
                            correct: 'get used to'
                        }
                    }
                ],

                // Game States
                gameMode: 'scramble',
                scrambleWord: {},
                scrambledLetters: [],
                scrambleInput: '',
                scrambleFeedback: '',
                scrambleSuccess: false,

                matchCards: [],
                selectedCards: [],

                get filteredWords() {
                    if (this.selectedCategory === 'all') return this.words;
                    if (this.selectedCategory === 'favorites') return this.words.filter(w => this.stats.favorites.includes(w.id));
                    return this.words.filter(w => w.category === this.selectedCategory);
                },

                get currentWord() {
                    return this.filteredWords[this.currentCardIndex] || this.words[0];
                },

                get searchedWords() {
                    if (!this.searchQuery) return this.filteredWords;
                    const q = this.searchQuery.toLowerCase();
                    return this.filteredWords.filter(w => 
                        w.word.toLowerCase().includes(q) || 
                        w.translation.toLowerCase().includes(q)
                    );
                },

                get currentGrammarTopic() {
                    return this.grammarTopics[this.activeGrammarIndex];
                },

                initApp() {
                    this.loadSavedData();
                    this.initQuiz();
                    this.initScrambleGame();
                    this.initMatchingGame();
                    this.setupPwaManifest();
                    
                    this.$nextTick(() => {
                        if (window.lucide) lucide.createIcons();
                    });
                },

                // Speech Synthesis
                speak(text) {
                    if ('speechSynthesis' in window) {
                        window.speechSynthesis.cancel();
                        const utterance = new SpeechSynthesisUtterance(text);
                        utterance.lang = 'en-US';
                        utterance.rate = 0.9;
                        window.speechSynthesis.speak(utterance);
                    }
                },

                // Flashcard Navigation
                nextCard() {
                    this.cardFlipped = false;
                    setTimeout(() => {
                        this.currentCardIndex = (this.currentCardIndex + 1) % this.filteredWords.length;
                    }, 150);
                },

                prevCard() {
                    this.cardFlipped = false;
                    setTimeout(() => {
                        this.currentCardIndex = (this.currentCardIndex - 1 + this.filteredWords.length) % this.filteredWords.length;
                    }, 150);
                },

                toggleFavorite(id) {
                    if (this.stats.favorites.includes(id)) {
                        this.stats.favorites = this.stats.favorites.filter(item => item !== id);
                    } else {
                        this.stats.favorites.push(id);
                    }
                    this.saveData();
                },

                isFavorite(id) {
                    return this.stats.favorites.includes(id);
                },

                toggleMastered(id) {
                    if (this.stats.masteredWords.includes(id)) {
                        this.stats.masteredWords = this.stats.masteredWords.filter(item => item !== id);
                    } else {
                        this.stats.masteredWords.push(id);
                        this.addXP(15);
                    }
                    this.saveData();
                },

                isMastered(id) {
                    return this.stats.masteredWords.includes(id);
                },

                // Quiz Methods
                initQuiz() {
                    this.quizAnswered = false;
                    this.isQuizCorrect = false;
                    const randomIndex = Math.floor(Math.random() * this.words.length);
                    this.quizQuestion = this.words[randomIndex];

                    const wrongOptions = this.words
                        .filter(w => w.id !== this.quizQuestion.id)
                        .map(w => w.translation)
                        .sort(() => 0.5 - Math.random())
                        .slice(0, 3);

                    this.quizOptions = [...wrongOptions, this.quizQuestion.translation].sort(() => 0.5 - Math.random());
                },

                answerQuiz(option) {
                    if (this.quizAnswered) return;
                    this.quizAnswered = true;
                    if (option === this.quizQuestion.translation) {
                        this.isQuizCorrect = true;
                        this.quizScore += 10;
                        this.addXP(10);
                    } else {
                        this.isQuizCorrect = false;
                    }
                },

                nextQuizQuestion() {
                    this.initQuiz();
                    this.$nextTick(() => { if (window.lucide) lucide.createIcons(); });
                },

                getQuizOptionClass(option) {
                    if (!this.quizAnswered) {
                        return 'bg-slate-950/60 text-slate-200 hover:bg-indigo-600/10';
                    }
                    if (option === this.quizQuestion.translation) {
                        return 'bg-emerald-500/20 text-emerald-300 font-bold';
                    }
                    return 'bg-slate-950/30 text-slate-600 opacity-40';
                },

                // Grammar Methods
                checkGrammarAnswer(opt) {
                    this.grammarAnswered = true;
                    if (opt === this.currentGrammarTopic.exercise.correct) {
                        this.grammarIsCorrect = true;
                        this.addXP(15);
                    } else {
                        this.grammarIsCorrect = false;
                    }
                },

                getGrammarOptClass(opt) {
                    if (!this.grammarAnswered) {
                        return 'bg-slate-900 text-slate-200 hover:bg-indigo-600/10';
                    }
                    if (opt === this.currentGrammarTopic.exercise.correct) {
                        return 'bg-emerald-500/20 text-emerald-300 font-bold';
                    }
                    return 'bg-slate-950 text-slate-600 opacity-40';
                },

                // Game 1: Word Scramble
                initScrambleGame() {
                    this.scrambleFeedback = '';
                    this.scrambleInput = '';
                    const randomWordObj = this.words[Math.floor(Math.random() * this.words.length)];
                    this.scrambleWord = randomWordObj;
                    
                    let letters = randomWordObj.word.replace(/\s+/g, '').split('');
                    for (let i = letters.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [letters[i], letters[j]] = [letters[j], letters[i]];
                    }
                    this.scrambledLetters = letters;
                },

                checkScrambleAnswer() {
                    const cleanTarget = this.scrambleWord.word.replace(/\s+/g, '').toLowerCase();
                    const cleanInput = this.scrambleInput.replace(/\s+/g, '').toLowerCase();

                    if (cleanInput === cleanTarget) {
                        this.scrambleSuccess = true;
                        this.scrambleFeedback = 'Palabra correcta +20 XP';
                        this.addXP(20);
                        setTimeout(() => this.initScrambleGame(), 1800);
                    } else {
                        this.scrambleSuccess = false;
                        this.scrambleFeedback = 'Incorrecto. Inténtalo de nuevo';
                    }
                },

                // Game 2: Matching
                initMatchingGame() {
                    this.selectedCards = [];
                    const shuffledWords = [...this.words].sort(() => 0.5 - Math.random()).slice(0, 4);
                    
                    let cards = [];
                    shuffledWords.forEach((item, index) => {
                        cards.push({ id: `en-${index}`, pairId: index, text: item.word, type: 'en', matched: false });
                        cards.push({ id: `es-${index}`, pairId: index, text: item.translation, type: 'es', matched: false });
                    });

                    this.matchCards = cards.sort(() => 0.5 - Math.random());
                },

                selectMatchCard(card) {
                    if (this.selectedCards.length === 2 || this.selectedCards.find(c => c.id === card.id)) return;
                    
                    this.selectedCards.push(card);

                    if (this.selectedCards.length === 2) {
                        const [c1, c2] = this.selectedCards;
                        if (c1.pairId === c2.pairId && c1.type !== c2.type) {
                            setTimeout(() => {
                                c1.matched = true;
                                c2.matched = true;
                                this.selectedCards = [];
                                this.addXP(15);
                            }, 300);
                        } else {
                            setTimeout(() => {
                                this.selectedCards = [];
                            }, 700);
                        }
                    }
                },

                getMatchCardClass(card) {
                    if (card.matched) {
                        return 'bg-emerald-950/30 text-emerald-400 opacity-30';
                    }
                    const isSelected = this.selectedCards.find(c => c.id === card.id);
                    if (isSelected) {
                        return 'bg-indigo-600 text-white';
                    }
                    return 'bg-slate-950/60 text-slate-200 hover:bg-slate-850';
                },

                // XP Storage
                addXP(amount) {
                    this.stats.xp += amount;
                    this.saveData();
                },

                saveData() {
                    localStorage.setItem('english_vibe_stats', JSON.stringify(this.stats));
                },

                loadSavedData() {
                    const saved = localStorage.getItem('english_vibe_stats');
                    if (saved) {
                        try {
                            this.stats = { ...this.stats, ...JSON.parse(saved) };
                        } catch (e) {}
                    }
                },

                // Dynamic Manifest Generator
                setupPwaManifest() {
                    const manifest = {
                        name: "EnglishVibe B1-B2",
                        short_name: "EnglishVibe",
                        start_url: ".",
                        display: "standalone",
                        background_color: "#020617",
                        theme_color: "#4f46e5",
                        description: "Aprende inglés B1-B2 de forma interactiva."
                    };
                    const stringManifest = JSON.stringify(manifest);
                    const blob = new Blob([stringManifest], { type: 'application/json' });
                    const manifestUrl = URL.createObjectURL(blob);
                    document.getElementById('manifest-placeholder').setAttribute('href', manifestUrl);
                },

                // Download HTML standalone App
                downloadShortcutFile() {
                    const htmlContent = "<!DOCTYPE html>" + document.documentElement.outerHTML;
                    const blob = new Blob([htmlContent], { type: 'text/html' });
                    const a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = 'EnglishVibe_App.html';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }
            }
        }
    </script>
</body>
</html>